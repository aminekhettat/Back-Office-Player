#!/usr/bin/env bash
# =============================================================================
# git pre-push hook — Back-Office Player
#
# Enforces BEFORE every push:
#   1. ruff passes on all source files (0 warnings, 0 errors)
#   2. black formatting check passes
#   3. pytest passes with 100% coverage
#
# Install:  make hooks          (or copy manually to .git/hooks/pre-push)
# Skip:     git push --no-verify   (use only in emergencies)
# =============================================================================

set -euo pipefail

PYTHON="${PYTHON:-python}"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo ""
echo "════════════════════════════════════════════════════════"
echo "  BOP pre-push hook — running quality checks"
echo "════════════════════════════════════════════════════════"
echo ""

# ── 1. Lint ──────────────────────────────────────────────────────────────────
echo "▶ Step 1/3 — ruff lint check …"
if ! "$PYTHON" -m ruff check .; then
    echo ""
    echo "✗ ruff FAILED — fix the issues above before pushing."
    exit 1
fi
echo "✓ ruff passed"
echo ""

# ── 2. Format check ──────────────────────────────────────────────────────────
echo "▶ Step 2/3 — black formatting check …"
if ! "$PYTHON" -m black --check .; then
    echo ""
    echo "✗ black FAILED — run 'black .' to reformat before pushing."
    exit 1
fi
echo "✓ black passed"
echo ""

# ── 3. Tests + Coverage ──────────────────────────────────────────────────────
echo "▶ Step 3/3 — pytest with 100 % coverage requirement …"
if ! QT_QPA_PLATFORM=offscreen "$PYTHON" -m pytest tests/ \
        --cov=. \
        --cov-config=.coveragerc \
        --cov-report=term-missing \
        --cov-fail-under=100 \
        -q; then
    echo ""
    echo "✗ Tests FAILED or coverage < 100 % — fix before pushing."
    exit 1
fi
echo "✓ All tests passed — coverage ≥ 100 %"
echo ""

echo "════════════════════════════════════════════════════════"
echo "  ✓ All checks passed — push proceeding"
echo "════════════════════════════════════════════════════════"
echo ""
